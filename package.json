{
  "name": "theme-kit",
  "version": "1.1.0",
  "description": "Shared Appearance & Theme Editor pane and theme model for Jacob's apps",
  "type": "module",
  "license": "MIT",
  "repository": "github:JakeIwen/theme-kit",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./palette.css": "./palette.css"
  },
  "files": [
    "dist",
    "palette.css"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "check": "npm test && node scripts/check-dist.mjs",
    "demo": "npm run build && node scripts/serve-demo.mjs",
    "release": "node scripts/release.mjs",
    "fanout": "node scripts/fanout.mjs"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "typescript": "5.9.2"
  }
}
